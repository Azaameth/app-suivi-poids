{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "npm_config_loglevel": "error"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh api repos/Azaameth/app-suivi-poids/*)",
      "Bash(node scripts/*)",
      "Bash(node .claude/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/service-account*.json)",
      "Read(./**/*-adminsdk-*.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/keystore.properties)",
      "Bash(firebase deploy*)",
      "Bash(npx firebase deploy*)",
      "Bash(npm run deploy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-fous.mjs\"",
            "timeout": 30,
            "statusMessage": "Garde-fous…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/formater.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
