{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/service-account*.json)",
      "Read(./**/*-adminsdk-*.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/keystore.properties)",
      "Bash(firebase deploy*)",
      "Bash(npx firebase deploy*)",
      "Bash(npm run deploy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
