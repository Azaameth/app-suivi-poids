rules_version = '2';

// Refus par défaut : tout ce qui n'est pas explicitement autorisé ci-dessous est interdit.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // meta/ : deux documents seulement.
      // - keys : clé de données encapsulée. Suppression réservée au parcours « Supprimer mon
      //   compte » (confirmation forte, D47) : perdre wrappedKey rend toutes les données illisibles.
      // - profil (v1.1) : objectif et taille, cible et taille chiffrées (spec § 2, D46).
      match /meta/{docId} {
        allow read, delete: if isOwner() && docId in ['keys', 'profil'];
        allow create, update: if isOwner()
          && ((docId == 'keys' && isValidKeyMeta(request.resource.data))
            || (docId == 'profil' && isValidProfil(request.resource.data)));
      }

      // Suggestions (D45) : non chiffrées, créées, relues et supprimées par leur auteur seul.
      // Pas de modification : une suggestion envoyée est figée.
      match /suggestions/{id} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && isValidSuggestion(request.resource.data);
      }

      // Pesées : une par jour, identifiant = date (D16). Miroir de core/pesees/model.ts.
      // La dernière écriture remplace le document entier, createdAt compris (D6, D37) : un
      // appareil revenu en ligne ne connaît pas forcément le createdAt d'une saisie faite ailleurs.
      match /pesees/{date} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && isValidPesee(date, request.resource.data);
      }

      function isEncrypted(value) {
        return value is string && value.size() <= 4096
          && value.matches('^v1:[A-Za-z0-9+/=]+:[A-Za-z0-9+/=]+$');
      }

      // Clé encapsulée par la phrase et, facultatif, par le code de secours (D48).
      function isValidEnveloppe(e) {
        return isEncrypted(e.wrappedKey)
          && e.salt is string && e.salt.size() > 0
          && e.iterations is int && e.iterations >= 600000;
      }

      function isValidKeyMeta(data) {
        return data.keys().hasOnly(['wrappedKey', 'salt', 'iterations', 'version', 'secours'])
          && isValidEnveloppe(data)
          && data.version is int
          && (!('secours' in data)
            || (data.secours is map
              && data.secours.keys().hasOnly(['wrappedKey', 'salt', 'iterations'])
              && isValidEnveloppe(data.secours)));
      }

      // Miroir de core/profil/model.ts : tolérance de 0,5 à 3 kg par pas de 0,5, et seulement
      // pour « maintenir » ; une cible dès qu'il y a un usage.
      function isValidProfil(data) {
        return data.keys().hasOnly(['usage', 'cible', 'tolerance', 'taille', 'updatedAt'])
          && data.keys().hasAll(['usage', 'updatedAt'])
          && (data.usage == null || data.usage in ['perdre', 'gagner', 'maintenir'])
          && (data.usage == null || 'cible' in data)
          && (!('cible' in data) || isEncrypted(data.cible))
          && (!('taille' in data) || isEncrypted(data.taille))
          && (!('tolerance' in data)
            || (data.usage == 'maintenir'
              && data.tolerance is number
              && data.tolerance >= 0.5 && data.tolerance <= 3.0
              && (data.tolerance * 2) % 1 == 0))
          && data.updatedAt is int;
      }

      function isValidSuggestion(data) {
        return data.keys().hasOnly(['type', 'texte', 'version', 'createdAt'])
          && data.keys().hasAll(['type', 'texte', 'version', 'createdAt'])
          && data.type in ['idee', 'probleme']
          && data.texte is string && data.texte.size() >= 10 && data.texte.size() <= 2000
          && data.version is string && data.version.size() >= 1 && data.version.size() <= 32
          && data.createdAt is int;
      }

      function isValidPesee(id, data) {
        return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.keys().hasAll(['date', 'poids', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['date', 'poids', 'note', 'createdAt', 'updatedAt'])
          && data.date == id
          && isEncrypted(data.poids)
          && (!('note' in data) || isEncrypted(data.note))
          && data.createdAt is int && data.updatedAt is int
          && data.updatedAt >= data.createdAt;
      }
    }
  }
}
