rules_version = '2';

// Refus par défaut : tout ce qui n'est pas explicitement autorisé ci-dessous est interdit.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Méta-données de la clé de données : seul document autorisé dans meta/.
      // Suppression interdite : perdre wrappedKey rendrait toutes les données illisibles.
      match /meta/{docId} {
        allow read: if isOwner() && docId == 'keys';
        allow create, update: if isOwner() && docId == 'keys' && isValidKeyMeta(request.resource.data);
        allow delete: if false;
      }

      // Pesées : une par jour, identifiant = date (D16). Miroir de core/pesees/model.ts.
      // La dernière écriture remplace le document entier, createdAt compris (D6, D37) : un
      // appareil revenu en ligne ne connaît pas forcément le createdAt d'une saisie faite ailleurs.
      match /pesees/{date} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && isValidPesee(date, request.resource.data);
      }

      function isEncrypted(value) {
        return value is string && value.size() <= 4096
          && value.matches('^v1:[A-Za-z0-9+/=]+:[A-Za-z0-9+/=]+$');
      }

      function isValidKeyMeta(data) {
        return data.keys().hasOnly(['wrappedKey', 'salt', 'iterations', 'version'])
          && isEncrypted(data.wrappedKey)
          && data.salt is string && data.salt.size() > 0
          && data.iterations is int && data.iterations >= 600000
          && data.version is int;
      }

      function isValidPesee(id, data) {
        return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.keys().hasAll(['date', 'poids', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['date', 'poids', 'note', 'createdAt', 'updatedAt'])
          && data.date == id
          && isEncrypted(data.poids)
          && (!('note' in data) || isEncrypted(data.note))
          && data.createdAt is int && data.updatedAt is int
          && data.updatedAt >= data.createdAt;
      }
    }
  }
}
