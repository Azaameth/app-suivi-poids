{
  "name": "app-suivi-poids",
  "private": true,
  "version": "0.2.1",
  "description": "Professeur Machimoto — suivi de poids chiffré (web + Android), synchronisé avec Firebase.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js . && prettier --config config/prettier.json --ignore-path config/prettierignore --check .",
    "format": "prettier --config config/prettier.json --ignore-path config/prettierignore --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --config config/vite.config.ts",
    "test:watch": "vitest --config config/vite.config.ts",
    "test:emulateurs": "firebase emulators:exec --config firebase/firebase.tests.json --only auth,firestore --project demo-suivi-poids \"vitest run --config config/vitest.emulateurs.config.ts\" && node scripts/empreinte.mjs marquer emulateurs",
    "emulators": "firebase emulators:start --project demo-suivi-poids --import=.emulator-data --export-on-exit=.emulator-data",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify": "npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run test:outils && npm run build && node scripts/empreinte.mjs marquer verify",
    "deploy": "npm run verify && npm run test:emulateurs && firebase deploy --project machimoto --only hosting,firestore:rules",
    "test:outils": "node --test \".claude/hooks/*.test.mjs\" \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
